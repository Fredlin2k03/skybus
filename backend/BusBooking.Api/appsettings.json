{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "// NOTE": "Phase 1 connects directly to Azure SQL from localhost. Replace <server>, <database>, <username>, <password>. In Phase 2 this moves to Key Vault + Managed Identity.",
    "DefaultConnection": "Server=tcp:<your-server-name>.database.windows.net,1433;Initial Catalog=<your-database-name>;Persist Security Info=False;User ID=<your-admin-user>;Password=<your-password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },

  "Jwt": {
    "// NOTE": "Dev-only signing key. Move to Azure Key Vault before production.",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_DEV_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "BusBookingApi",
    "Audience": "BusBookingClient",
    "ExpiryMinutes": 120
  },

  "UpiSettings": {
    "PayeeVpa": "busbooking@upi",
    "PayeeName": "BusBooking Demo",
    "PaymentWindowSeconds": 180
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
